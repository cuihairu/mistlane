<Contracts>
  <!-- Business scenario contract: the minimal login/room/move/heartbeat
       vocabulary the scenario bot (mistlane bot --scenario business) drives
       against a gameServer hosting this document. Self-contained (no
       TypesSource) so both the node and the bot can load it standalone. All
       methods are caller="server": the framework attributes callers from the
       trusted transport, so a scenario bot presents MLS1 service identity and
       invokes through the identified internal path (plain client legs are
       FORBIDDEN server methods by design until owner attribution ships).
       Argument and return ids share one id space per method. -->
  <Entity name="Player" id="2">
    <ServerMethods>
      <Method name="login" id="1" mode="request" caller="server"><Arg name="token" id="0" type="STRING"/><Returns><Field name="ok" id="1" type="UINT16"/></Returns></Method>
      <Method name="joinRoom" id="2" mode="request" caller="server"><Arg name="room" id="0" type="UINT32"/><Returns><Field name="ok" id="1" type="UINT16"/></Returns></Method>
      <Method name="move" id="3" mode="request" caller="server"><Arg name="x" id="0" type="INT32"/><Arg name="y" id="1" type="INT32"/><Returns><Field name="seq" id="2" type="UINT32"/></Returns></Method>
      <Method name="heartbeat" id="4" mode="request" caller="server"><Returns><Field name="seq" id="0" type="UINT32"/></Returns></Method>
      <Method name="leaveRoom" id="5" mode="request" caller="server"><Arg name="room" id="0" type="UINT32"/><Returns><Field name="ok" id="1" type="UINT16"/></Returns></Method>
    </ServerMethods>
  </Entity>
</Contracts>
