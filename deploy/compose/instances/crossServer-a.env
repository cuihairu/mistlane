# Container override for the crossServer-a instance. LISTEN binds the
# published bridge interface and METRICS_LISTEN exposes the Prometheus scrape
# face through the published metrics port (tools/container_stress.sh).
ROLE=crossServer
LISTEN=0.0.0.0:7201
SCRIPT=scripts/cross.lua
TRANSPORT=tcp
UPSTREAMS=
ROUTE_EPOCH=1
METRICS_LISTEN=0.0.0.0:7203
# The bench pipelines far past the default per-session flood guard
# (200 burst / 100 per second); raise it so the drill measures throughput.
RATE_CAPACITY=1000000
RATE_REFILL=1000000

# The 128-connection ceiling leg exceeds the default admission envelope
# (256 MiB reserves ~6.3 MiB per session, ~42 sessions); raise the budget.
MAX_CONNECTIONS=1024
MEMORY_BUDGET_MIB=2048

# The gateway may direct every join of one room name here, so the per-room
# cap must accept the 128-join ceiling leg too.
MAX_ROOM_SESSIONS=256
