# Container override for the cross-routing gateway of the stress cluster: the
# upstreams are the crossServer service names resolved on the compose network,
# and the metrics face is published for the drill's scrape.
ROLE=gateway
ROUTING=cross
LISTEN=0.0.0.0:7300
SCRIPT=
TRANSPORT=tcp
UPSTREAMS=cross-a:7201,cross-b:7202
ROUTE_EPOCH=1
METRICS_LISTEN=0.0.0.0:7301
# Raised flood guard: the bench's closed-loop pipelining would exhaust the
# default per-session bucket (200 burst / 100 per second) mid-run.
RATE_CAPACITY=1000000
RATE_REFILL=1000000

# The 128-connection ceiling leg exceeds the default admission envelope
# (256 MiB reserves ~6.3 MiB per session, ~42 sessions); raise the budget.
MAX_CONNECTIONS=1024
MEMORY_BUDGET_MIB=2048

# The cross gateway counts room participants too; raise the per-room cap
# so the 128-join ceiling leg is admitted.
MAX_ROOM_SESSIONS=256
