# Container override for the crossServer-b instance; same shape as
# crossServer-a.env on the second port pair.
ROLE=crossServer
LISTEN=0.0.0.0:7202
SCRIPT=scripts/cross.lua
TRANSPORT=tcp
UPSTREAMS=
ROUTE_EPOCH=1
METRICS_LISTEN=0.0.0.0:7204
# Same raised flood guard as crossServer-a.env.
RATE_CAPACITY=1000000
RATE_REFILL=1000000

# The 128-connection ceiling leg exceeds the default admission envelope
# (256 MiB reserves ~6.3 MiB per session, ~42 sessions); raise the budget.
MAX_CONNECTIONS=1024
MEMORY_BUDGET_MIB=2048

# Same raised per-room cap as crossServer-a.env.
MAX_ROOM_SESSIONS=256
