# Container override for the gateway instance. In a single container the
# scaffold default upstream (127.0.0.1:7102) is the node's own loopback; in a
# compose cluster the upstream is the gameServer service, resolved over the
# compose network by name. Everything else keeps the image default.
ROLE=gateway
LISTEN=0.0.0.0:7100
SCRIPT=
TRANSPORT=tcp
UPSTREAMS=gameServer:7102
ROUTE_EPOCH=
