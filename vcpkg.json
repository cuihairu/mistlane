{
  "name": "mistlane",
  "version-semver": "0.1.0",
  "description": "A lightweight C++/Lua multi-process service framework extracted and modernized from FOGS",
  "license": "Apache-2.0",
  "builtin-baseline": "a5f736224e85b32e25a8ffc52562333180396642",
  "dependencies": [
    {
      "name": "boost-asio",
      "version>=": "1.92.0",
      "default-features": false,
      "features": [
        "ssl"
      ]
    },
    {
      "name": "boost-redis",
      "version>=": "1.92.0"
    },
    {
      "name": "boost-mysql",
      "version>=": "1.92.0"
    },
    {
      "name": "lua",
      "version>=": "5.5.1"
    },
    {
      "name": "sqlite3",
      "version>=": "3.50.4"
    },
    {
      "name": "openssl",
      "version>=": "3.6.5"
    },
    {
      "name": "drogon",
      "version>=": "1.9.14",
      "default-features": false
    },
    {
      "name": "trantor",
      "version>=": "1.5.28"
    },
    {
      "name": "curl",
      "version>=": "8.23.0",
      "default-features": false,
      "features": [
        "openssl"
      ]
    },
    "crashpad",
    {
      "name": "prometheus-cpp",
      "default-features": false,
      "features": ["pull"]
    }
  ],
  "homepage": "https://github.com/cuihairu/mistlane"
}
